{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MA9",
    "description": "基于 MaaFramework 的《狂野飙车 9》国服自动化工具。",
    "contact": "https://github.com/Testiphi/MA9/issues",
    "license": "AGPL-3.0-or-later",
    "welcome": "欢迎使用 MA9。当前项目处于多人循环开发试跑阶段。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/Testiphi/MA9",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    // 开发环境使用项目内虚拟环境。发布脚本会改写为随包携带的 Agent 可执行文件。
    "agent": {
        "child_exec": "../.venv/Scripts/python.exe",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
